# Old reference code — never push
OldCode/

# Working material — prototypes, prompt notes, session transcripts
stitch/
Prompt.md
prompt.md
session-*.md

# Sibling repos (own git) — never push into core
Plugin-Hub/
testing/

# Dependencies
node_modules/
app/node_modules/

# Build output
dist/
app/dist/

# Env / secrets
.env
.env.*
!.env.example
app/.env
app/.env.*

# Docker runtime (volumes, local overrides — generated, never pushed)
db/
models/
downloads/
tasks/
config/
plugin-requirements.txt
docker-compose.override.yml

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local caches
.vite/
*.local

# Installed plugins — mirrors backend <root>/plugins (PLUGINS_DIR).
# The folder ships empty; contents are cloned at install time.
plugins/*
!plugins/.gitkeep

# Backend runtime — SQLite lives here, never push it
backend/data/
backend/.venv/
backend/*.log
backend/*.pid
app/.vite.pid
*.db
*.db-journal
__pycache__/
*.pyc

# Rebuild-required marker (set by plugin install/uninstall/volume changes)
.rebuild-required
.rebuild.log
